{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@azes/typescript-config/base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "declaration": false,
    "declarationMap": false
