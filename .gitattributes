# Purpose: Normalize line endings and mark binary assets for Git
# Layer: tooling

* text=auto eol=lf

*.{cmd,bat} text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp4 binary
*.mov binary
