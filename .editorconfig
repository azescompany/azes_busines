# AZES COMPANY
# File: .editorconfig
# Author: AZES_COMPANY
# Created: 2026-08-22
# Updated: 2026-08-22
# Purpose: Editor-agnostic formatting defaults for the monorepo
# Layer: tooling

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf
