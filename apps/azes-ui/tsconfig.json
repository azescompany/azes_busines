{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@azes/typescript-config/react.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals"],
    "paths": {
      "@/*": ["./src/*"],
      "@azes/assets/*": ["../../packages/assets/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "node_modules"]
}
