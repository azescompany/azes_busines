# Server-only — never prefix with VITE_ (would leak to the browser bundle).
NVIDIA_API_KEY=
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Set to 1 behind corporate TLS inspection (self-signed MITM). Local demo only.
NVIDIA_TLS_INSECURE=0
