{
  "name": "@azes/api-server",
  "version": "0.0.0",
  "private": true,
  "description": "AZES HTTP API — Hono on Cloudflare Workers + D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply azes-api --local",
    "seed:local-user": "node scripts/seed-local-user.mjs",
    "seed:role-users": "node scripts/seed-role-users.mjs",
    "seed:lms": "node scripts/seed-lms.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@azes/typescript-config": "workspace:*",
    "@azes/vitest-config": "workspace:*",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^24.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.151.2"
  }
}
