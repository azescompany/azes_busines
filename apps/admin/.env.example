# Updated: 2026-10-26
# Purpose: Example env for @azes/admin (API + Account login origin)
# Layer: app
#
# Copy to `.env` (gitignored).

# Backend origin only (no trailing path).
VITE_API_BASE_URL=http://127.0.0.1:8787

# Account login SPA — unauthenticated users redirect here with returnUrl.
VITE_ACCOUNT_APP_URL=http://localhost:100

# Optional production cookie domain for SSO (e.g. .caspiankey.az).
# Leave empty on localhost — cookies are host-scoped and shared across ports.
# VITE_AUTH_COOKIE_DOMAIN=
