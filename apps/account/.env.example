# AZES COMPANY
# File: apps/account/.env.example
# Author: AZES_COMPANY
# Created: 2026-10-04
# Updated: 2026-10-19
# Purpose: Example env for @azes/account (API origin + handoff targets)
# Layer: app
#
# Copy to `.env` (gitignored). Handoffs use THESE URLs only — never hardcoded ports.
#
# Local port matrix (package.json `dev` / Vite):
#   account :100
#   admin   :200  (apps/admin — default post-login handoff)
#   agent-site :300 (legacy / optional)
#   real-estate-site :400 (legacy / optional)
# Production: set https://… origins (no trailing slash). Cookie domain optional below.

# Backend origin only (no trailing path, no /api).
# Local AZES api-server (Wrangler): http://127.0.0.1:8787

VITE_API_BASE_URL=http://127.0.0.1:8787


# Default post-login target (admin contract). Also an allowed returnUrl origin.
VITE_ADMIN_APP_URL=http://localhost:200

# Legacy allowlist slot (Academy removed) — keep distinct origin if needed later.
VITE_ACADEMY_APP_URL=http://localhost:200

# Next agent-site — allowed returnUrl for admin → site configure handoff.
VITE_AGENT_SITE_APP_URL=http://localhost:300

# Caspian marketplace (`real-estate-site`) — allowed returnUrl for Site Entry.
VITE_REAL_ESTATE_SITE_APP_URL=http://localhost:400

# Optional production cookie domain for SSO between account + admin (e.g. .caspiankey.az).
# Leave empty on localhost — cookies are host-scoped and shared across ports.
# VITE_AUTH_COOKIE_DOMAIN=

# Optional: pin a backend-registered device fingerprint when hitting prod from localhost.
# Unknown / mismatched fingerprints → 400 "Fields məlumatları tapılmadı".
# Copy ALL four fields from a successful prod login **request JSON body** (Network tab).
# VITE_DEVICE_ID alone is IGNORED (incomplete seed caused recurring 400s).
# Must mirror the same four values on the consuming app — one-sided override → user-menu 403.
# VITE_DEVICE_ID=
# VITE_DEVICE_USER_AGENT=
# VITE_DEVICE_PLATFORM=Win32
# VITE_DEVICE_LANGUAGE=en-US
