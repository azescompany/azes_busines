{
  "name": "@azes/auth",
  "version": "0.0.0",
  "private": true,
  "description": "AZES authentication contracts and web/native adapters (backend remains authoritative)",
  "type": "module",
  "sideEffects": [
    "./dist/react/AuthProvider.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
