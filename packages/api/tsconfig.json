{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@azes/typescript-config/react.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "jsx": "react-jsx"
  },
  "include": ["src", "generated/admin", "generated/azes"],

  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "dist",
    "node_modules",
    "generated/placeholder"
  ]
}
